# ===== ローカル開発（docker-compose.yml + db コンテナ） =====
MYSQL_DATABASE=wordpress
MYSQL_USER=wordpress
MYSQL_PASSWORD=wordpress
MYSQL_ROOT_PASSWORD=rootpassword

WORDPRESS_PORT=8080
MAILCATCHER_WEB_PORT=1080
# WORDPRESS_HTML_PATH=./html
# WORDPRESS_IMAGE_TAG=latest

# ===== 本番（docker-compose.prod.yml + ホスト DB） =====
# WORDPRESS_DB_HOST=db-host:3306
# MYSQL_DATABASE=wordpress
# MYSQL_USER=wordpress
# MYSQL_PASSWORD=
# PlaPro(3000) / Redmine(3001) と被らないホスト側ポート
# WORDPRESS_HOST_PORT=8081
# リバースプロキシ配下の URL（混在コンテンツ防止）
# WORDPRESS_HOME=https://example.tecono.jp
# WORDPRESS_SITEURL=https://example.tecono.jp
